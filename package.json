{
  "name": "video-meta-editor",
  "version": "1.0.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "start-fast": "electron .",
    "build": "react-scripts build",
    "electron-start": "electron .",
    "dist": "react-scripts build && electron-builder"
  },
  "build": {
    "appId": "com.moriel.videometaeditor",
    "productName": "Video Meta Editor",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "ipcHandler.js",
      "ffmpegService.js",
      "tmdbService.js",
      "offlineService.js",
      "preload.js",
      "!bin/**/*"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^9.2.2",
    "@mantine/hooks": "^9.2.2",
    "@tabler/icons-react": "^3.44.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/electron-store": "^3.2.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.13.3",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
